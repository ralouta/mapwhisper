# Your ArcGIS Online Web Map ID (the one with tactile map descriptions)
VITE_WEBMAP_ID=your_webmap_id_here
# Your ArcGIS Online OAuth App ID
VITE_OAUTH_APP_ID=your_oauth_app_id_here
# Portal URL (default: ArcGIS Online)
VITE_PORTAL_URL=https://www.arcgis.com

# Spoken-language detection provider: heuristic | llm | hybrid
VITE_LANG_DETECT_PROVIDER=hybrid

# OpenAI-compatible LLM endpoint for language detection
# Example OpenAI cloud: https://api.openai.com/v1
# Example local server: http://localhost:11434/v1
VITE_LLM_BASE_URL=
VITE_LLM_MODEL=
VITE_LLM_API_KEY=
# Azure OpenAI only: api-version (e.g. 2024-10-21). Leave blank for standard OpenAI.
VITE_LLM_API_VERSION=
